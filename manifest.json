{
  "manifest_version": 3,
  "name": "Site Timer",
  "version": "2.0",
  "description": "Per-site countdown that closes the tab when time's up, to stop doomscrolling.",
  "permissions": ["storage", "activeTab", "notifications"],
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Site Timer settings" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "timer.js"],
      "run_at": "document_start"
    }
  ]
}
