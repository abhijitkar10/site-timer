{
  "manifest_version": 3,
  "name": "Site Timer",
  "version": "1.1",
  "description": "Time-on-page timer, with a daily countdown that blocks doomscrolling sites.",
  "permissions": ["storage", "activeTab"],
  "action": { "default_popup": "popup.html", "default_title": "Site Timer settings" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "timer.js"],
      "run_at": "document_start"
    }
  ]
}
